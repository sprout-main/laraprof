<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS redirect so the browser always loads with the SSL lock icon
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect everything to the /public folder (simulates setting the docroot to public).
    # This keeps the full Laravel directory structure intact on InfinityFree.
    RewriteRule (.*) /public/$1 [L]
</IfModule>
